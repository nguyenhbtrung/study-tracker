{
  "compilerOptions": {
    "target": "ES6",
    "allowJs": true,
    "module": "commonjs",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "outDir": "dist",
    "rootDir": "src",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // "useDefineForClassFields": false,

    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "@main/*": ["src/main/*"],
      "@renderer/*": ["src/renderer/*"],
      "@shared/*": ["src/shared/*"],
      "*": ["node_modules/*"]
    }
  },
  "include": ["src/**/*"]
}
